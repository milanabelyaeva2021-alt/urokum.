# Приклад налаштування. Не вписуй сюди справжні ключі й не публікуй їх у GitHub.
# Для Render додай ключі лише в Dashboard → Environment.
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=openrouter/free

# Безкоштовні квоти: задавай лише ключі, до яких маєш доступ.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Для платного OpenAI потрібно ЯВНО увімкнути прапорець (за замовчуванням вимкнено).
ALLOW_PAID_AI=false
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Доступ до /api/upload та редагування змісту: секрет >=24 символів.
# Не вмикай, якщо редактор підручників не потрібен.
# UROKUM_ADMIN_TOKEN=
